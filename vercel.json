{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/tts/synthesize",
      "destination": "/api/tts/synthesize"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
